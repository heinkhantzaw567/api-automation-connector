# Copy this file to .env and fill in real values.
# Never commit the real .env to git.

# Where to send the daily summary. Leave blank to skip that channel.
SLACK_WEBHOOK_URL=

# City to pull weather for (used by the public Open-Meteo API call)
CITY_LATITUDE=43.6532
CITY_LONGITUDE=-79.3832
CITY_NAME=Toronto
